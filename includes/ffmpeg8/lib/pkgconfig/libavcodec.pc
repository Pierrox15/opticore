prefix=/opt/games/libs/ffmpeg8
exec_prefix=${prefix}
libdir=/opt/games/libs/ffmpeg8/lib
includedir=/opt/games/libs/ffmpeg8/include

Name: libavcodec
Description: FFmpeg codec library
Version: 62.11.100
Requires: 
Requires.private: libswresample >= 6.1.100, libavutil >= 60.8.100
Conflicts:
Libs: -L${libdir}  -lavcodec 
Libs.private: -pthread -lm -latomic -llzma -lz -lva
Cflags: -I${includedir}
