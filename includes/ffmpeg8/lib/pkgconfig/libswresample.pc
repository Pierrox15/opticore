prefix=/opt/games/libs/ffmpeg8
exec_prefix=${prefix}
libdir=/opt/games/libs/ffmpeg8/lib
includedir=/opt/games/libs/ffmpeg8/include

Name: libswresample
Description: FFmpeg audio resampling library
Version: 6.1.100
Requires: 
Requires.private: libavutil >= 60.8.100
Conflicts:
Libs: -L${libdir}  -lswresample 
Libs.private: -lm -latomic
Cflags: -I${includedir}
