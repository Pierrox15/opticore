prefix=/opt/games/libs/ffmpeg8
exec_prefix=${prefix}
libdir=/opt/games/libs/ffmpeg8/lib
includedir=/opt/games/libs/ffmpeg8/include

Name: libavfilter
Description: FFmpeg audio/video filtering library
Version: 11.4.100
Requires: 
Requires.private: libswscale >= 9.1.100, libavformat >= 62.3.100, libavcodec >= 62.11.100, libswresample >= 6.1.100, libavutil >= 60.8.100
Conflicts:
Libs: -L${libdir}  -lavfilter 
Libs.private: -pthread -lm -latomic -lva
Cflags: -I${includedir}
